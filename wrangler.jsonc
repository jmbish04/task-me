{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-cloudflare-kickstart",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "TASK_CACHE",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TASK_ARTIFACTS",
      "bucket_name": "task-me-artifacts",
      "preview_bucket_name": "task-me-artifacts-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
