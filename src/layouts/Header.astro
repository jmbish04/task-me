---
import Logo from "../assets/logo.svg";

const links = [
  {
    id: "styleguide",
    label: "Styleguide",
    url: "/styleguide",
  },
];
---

<header class="bg-card">
  <nav
    class="page-width flex items-center justify-between p-6 lg:px-8"
    aria-label="Global"
  >
    <div class="flex lg:flex-1">
      <a href="/">
        <span class="sr-only">Bit Symphony</span>
        <Logo class="h-10 w-auto" role="img" />
      </a>
    </div>
    <div class="flex lg:hidden">
      <button
        id="open-mobile-nav-button"
        type="button"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-muted-foreground"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="size-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
          data-slot="icon"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
    <div class="hidden lg:flex lg:gap-x-12">
      {
        links.map((i) => (
          <a href={i.url} class="text-sm/6 font-semibold text-card-foreground">
            {i.label}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- Mobile menu, show/hide based on menu open state. -->
  <div
    id="mobile-nav-menu"
    class="lg:hidden hidden"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <!-- Background backdrop, show/hide based on slide-over state. -->
    <div
      class="fixed inset-0 z-10 bg-gray-900 opacity-50"
      id="mobile-nav-menu-backdrop"
    >
    </div>
    <div
      class="fixed inset-y-0 right-0 z-10 w-full overflow-y-auto bg-card px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10"
    >
      <div class="flex items-center justify-between">
        <a href="#" class="-m-1.5 p-1.5">
          <span class="sr-only">Your Company</span>
          <Logo class="h-8 w-auto" role="img" aria-label="Bit Symphony Logo" />
        </a>
        <button
          id="close-mobile-nav-button"
          type="button"
          class="-m-2.5 rounded-md p-2.5 text-muted-foreground"
        >
          <span class="sr-only">Close menu</span>
          <svg
            class="size-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
            data-slot="icon"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-gray-500/10">
          <div class="space-y-2 py-6">
            {
              links.map((i) => (
                <a
                  href={i.url}
                  class="-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-card-foreground hover:bg-gray-50"
                >
                  {i.label}
                </a>
              ))
            }
          </div>
          <!--<div class="py-6">
            <a
              href="#"
              class="-mx-3 block rounded-lg px-3 py-2.5 text-base/7 font-semibold text-card-foreground hover:bg-gray-50"
              >Log in</a
            >
          </div>-->
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const openNavMenuButton = document.getElementById("open-mobile-nav-button");
  const closeNavMenuButton = document.getElementById("close-mobile-nav-button");
  const navMenuBackdrop = document.getElementById("mobile-nav-menu-backdrop");
  const navMenu = document.getElementById("mobile-nav-menu");

  openNavMenuButton?.addEventListener("click", () => {
    navMenu?.classList.toggle("hidden");
    navMenu?.setAttribute("aria-hidden", "false");
  });
  closeNavMenuButton?.addEventListener("click", () => {
    navMenu?.classList.toggle("hidden");
    setTimeout(() => navMenu?.setAttribute("aria-hidden", "true"), 10);
  });
  navMenuBackdrop?.addEventListener("click", () => {
    navMenu?.classList.toggle("hidden");
    navMenu?.setAttribute("aria-hidden", "true");
  });
</script>
