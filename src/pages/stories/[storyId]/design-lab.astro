---
import RootLayout from "@/layouts/RootLayout.astro";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Textarea } from "@/components/ui/textarea";
import { createSupabaseClientFromEnv } from "@/lib/supabase";

export const prerender = false;

const { storyId } = Astro.params;
const env = (Astro.locals.runtime?.env ?? import.meta.env) as Record<string, string>;
const supabase = createSupabaseClientFromEnv(env);

const { data: story } = supabase
  ? await supabase
      .from("stories")
      .select("id, title, description, project_id")
      .eq("id", storyId ?? "")
      .single()
  : { data: null };

const { data: mockups } = supabase
  ? await supabase
      .from("mockups")
      .select("r2_url, source_url")
      .eq("story_id", storyId ?? "")
      .order("created_at", { ascending: false })
      .limit(1)
  : { data: [] };

const mockupUrl = mockups?.[0]?.r2_url ?? mockups?.[0]?.source_url ?? null;
---

<RootLayout title="Design Lab">
  <section class="page-section page-gap">
    <div class="flex flex-col gap-2">
      <a
        class="text-sm font-semibold text-primary"
        href={story?.project_id ? `/projects/${story.project_id}` : "/dashboard"}
      >
        ← Back to project
      </a>
      <h1>Design Lab</h1>
      <p class="text-subtitle">
        Collaborate with the UX agent to refine the UI for this user story.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <Card className="h-full">
        <CardHeader>
          <CardTitle as="h3">{story?.title ?? "User Story"}</CardTitle>
          <CardDescription>
            {story?.description ??
              "Share feedback to iterate on the stitched mockup."}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form class="space-y-4" method="post" action={`/api/stories/${storyId}/feedback`}>
            <label class="text-sm font-semibold text-card-foreground" for="feedback">
              UX feedback
            </label>
            <Textarea
              id="feedback"
              name="feedback"
              required
              rows={5}
              placeholder="Make the background dark mode and simplify the checkout flow."
            />
            <Button type="submit" variant="default">
              Send to UX Agent
            </Button>
          </form>
        </CardContent>
      </Card>
      <Card className="h-full">
        <CardHeader>
          <CardTitle as="h3">Stitch Mockup</CardTitle>
          <CardDescription>
            Latest visual from Stitch MCP (stored in R2 for durability).
          </CardDescription>
        </CardHeader>
        <CardContent>
          {mockupUrl ? (
            <img
              src={mockupUrl}
              alt="Stitch mockup"
              class="w-full rounded-lg border"
            />
          ) : (
            <div class="flex min-h-[240px] items-center justify-center rounded-lg border border-dashed text-sm text-muted-foreground">
              No mockup yet. Submit feedback to generate one.
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  </section>
</RootLayout>
