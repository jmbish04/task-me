---
import RootLayout from "@/layouts/RootLayout.astro";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { createSupabaseClientFromEnv } from "@/lib/supabase";

export const prerender = false;

const { storyId } = Astro.params;
const env = (Astro.locals.runtime?.env ?? import.meta.env) as Record<string, string>;
const supabase = createSupabaseClientFromEnv(env);

const { data: story } = supabase
  ? await supabase
      .from("stories")
      .select("id, title, project_id")
      .eq("id", storyId ?? "")
      .single()
  : { data: null };

const { data: tasks } = supabase
  ? await supabase
      .from("tasks")
      .select("id, title, description, status")
      .eq("story_id", storyId ?? "")
      .order("created_at", { ascending: true })
  : { data: [] };
---

<RootLayout title="Story Tasks">
  <section class="page-section page-gap">
    <div class="flex flex-col gap-2">
      <a
        class="text-sm font-semibold text-primary"
        href={story?.project_id ? `/projects/${story.project_id}` : "/dashboard"}
      >
        ← Back to project
      </a>
      <h1>{story?.title ?? "Story Tasks"}</h1>
      <p class="text-subtitle">
        Review tasks for this story and delegate build work to Jules.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="grid gap-4">
      {(tasks ?? []).map((task) => (
        <Card>
          <CardHeader>
            <CardTitle as="h3">{task.title}</CardTitle>
            <CardDescription>
              {task.description ?? "Task details pending."}
            </CardDescription>
          </CardHeader>
          <CardContent className="flex items-center justify-between">
            <span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700">
              {task.status}
            </span>
            <Button as="a" href={`/tasks/${task.id}`} variant="outline">
              View task
            </Button>
          </CardContent>
        </Card>
      ))}
      {(tasks ?? []).length === 0 && (
        <Card>
          <CardHeader>
            <CardTitle as="h3">No tasks yet</CardTitle>
            <CardDescription>
              Genesis will populate tasks for this story automatically.
            </CardDescription>
          </CardHeader>
        </Card>
      )}
    </div>
  </section>
</RootLayout>
