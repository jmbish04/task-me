---
import RootLayout from "@/layouts/RootLayout.astro";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { createSupabaseClientFromEnv } from "@/lib/supabase";

export const prerender = false;

const { projectId } = Astro.params;
const env = (Astro.locals.runtime?.env ?? import.meta.env) as Record<string, string>;
const supabase = createSupabaseClientFromEnv(env);

const { data: project } = supabase
  ? await supabase
      .from("projects")
      .select("id, title, description, repo_url")
      .eq("id", projectId ?? "")
      .single()
  : { data: null };

const { data: epics } = supabase
  ? await supabase
      .from("epics")
      .select("id, title, description, sort_order")
      .eq("project_id", projectId ?? "")
      .order("sort_order", { ascending: true })
  : { data: [] };

const { data: stories } = supabase
  ? await supabase
      .from("stories")
      .select("id, title, description, status, epic_id")
      .eq("project_id", projectId ?? "")
      .order("created_at", { ascending: true })
  : { data: [] };

const storiesByEpicId = (stories ?? []).reduce((acc, story) => {
  if (story.epic_id) {
    acc[story.epic_id] = acc[story.epic_id] ?? [];
    acc[story.epic_id].push(story);
  }
  return acc;
}, {} as Record<string, any[]>);
---

<RootLayout title={project?.title ?? "Project Board"}>
  <section class="page-section page-gap">
    <div class="flex flex-col gap-4">
      <a class="text-sm font-semibold text-primary" href="/dashboard">
        ← Back to dashboard
      </a>
      <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
        <div class="space-y-2">
          <h1>{project?.title ?? "Project Board"}</h1>
          <p class="text-subtitle">
            {project?.description ??
              "Track epics, user stories, and tasks generated by Genesis."}
          </p>
        </div>
        {project?.repo_url && (
          <Button as="a" href={project.repo_url} target="_blank" variant="outline">
            View GitHub Repo
          </Button>
        )}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="grid gap-6 lg:grid-cols-3">
      {(epics ?? []).map((epic) => (
        <Card className="h-full">
          <CardHeader>
            <CardTitle as="h3">{epic.title}</CardTitle>
            <CardDescription>
              {epic.description ?? "Epic generated by Genesis."}
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            {(storiesByEpicId[epic.id] ?? []).map((story) => (
              <div class="rounded-lg border bg-background p-4 shadow-sm">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="font-semibold text-card-foreground">{story.title}</p>
                    <p class="text-sm text-muted-foreground">
                      {story.description ?? "User story awaiting details."}
                    </p>
                  </div>
                  <span class="rounded-full bg-indigo-100 px-2 py-1 text-xs font-semibold text-indigo-700">
                    {story.status}
                  </span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <Button
                    as="a"
                    href={`/stories/${story.id}/design-lab`}
                    variant="outline"
                  >
                    Design Lab
                  </Button>
                  <Button as="a" href={`/stories/${story.id}/tasks`} variant="ghost">
                    View tasks
                  </Button>
                </div>
              </div>
            ))}
            {(storiesByEpicId[epic.id] ?? []).length === 0 && (
              <p class="text-sm text-muted-foreground">
                No stories yet for this epic.
              </p>
            )}
          </CardContent>
        </Card>
      ))}
      {(epics ?? []).length === 0 && (
        <Card className="lg:col-span-3">
          <CardHeader>
            <CardTitle as="h3">No epics yet</CardTitle>
            <CardDescription>
              Generate a plan from the dashboard to populate this board.
            </CardDescription>
          </CardHeader>
        </Card>
      )}
    </div>
  </section>
</RootLayout>
